package-as: cogworks

enable-nolib-creation: no

# Cogworks is a shared library; its CF/Wago audience is sibling-cog authors,
# so the engineering-focused CHANGELOG.md doubles as the project-page
# changelog (no separate player-facing file needed). manual-changelog is
# read at package time independent of the `ignore: "*.md"` list below — the
# file is uploaded as changelog metadata, not packaged into the zip.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

externals:
  Libs/LibStub:
    url: https://repos.wowace.com/wow/libstub/trunk
    tag: latest
  Libs/CallbackHandler-1.0:
    url: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
    tag: latest
  # NOTE: LibDataBroker-1.1 and LibDBIcon-1.0 are vendored under Libs/
  # rather than fetched as externals. The wowace SVN host (used for the
  # historical libdatabroker-1-1 mirror) periodically returns 500/502 errors
  # mid-build, breaking releases. FlipQueue made the same call for the same
  # reason — see C:/src/flipqueue/.pkgmeta. Lib upgrades happen by manually
  # refreshing the vendored copies; that's a rare enough cadence that the
  # build-stability win is worth the small maintenance cost.

ignore:
  - "*.md"
  - .gitignore
  - .claude
  - .vscode
  - .git
  - .github
  - docs
  - feedback
  # Headless Lua 5.1 specs (COG-83) — CI-only, never shipped to players.
  # Safe as a substring pattern: the only other path containing "test" is
  # .github/workflows/tests.yml, which .github already excludes. See the
  # COG-55 note below before adding any short pattern here.
  - test
  # NOTE: `Art/inner` was previously listed here to skip source PNGs at the
  # top-level `Art/inner/` directory. BigWigsMods packager treats ignore
  # patterns as substring matches against every path it visits, so the same
  # pattern also struck `Cogworks-1.0/Art/inner/` — the directory holding
  # the runtime TGAs (`cw-inner.tga`, `fq-inner.tga`, etc.). Result: the
  # Standalone minimap icon shipped without its inner-glyph artwork on
  # CurseForge/Wago. The source PNGs (~50KB) now ship in the release zip;
  # cost is negligible vs the visual breakage from missing TGAs. (COG-55)
