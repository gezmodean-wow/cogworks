package-as: cogworks

enable-nolib-creation: no

# Cogworks is a shared library; its CF/Wago audience is sibling-cog authors,
# so the engineering-focused CHANGELOG.md doubles as the project-page
# changelog (no separate player-facing file needed). manual-changelog is
# read at package time independent of the `ignore: "*.md"` list below — the
# file is uploaded as changelog metadata, not packaged into the zip.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

externals:
  Libs/LibStub:
    url: https://repos.wowace.com/wow/libstub/trunk
    tag: latest
  Libs/CallbackHandler-1.0:
    url: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
    tag: latest
  # LDB + LDBIcon power the standalone minimap button. Standalone-only —
  # sibling cogs already vendor their own copies via their own .pkgmeta.
  Libs/LibDataBroker-1.1:
    url: https://repos.wowace.com/wow/libdatabroker-1-1/trunk
    tag: latest
  Libs/LibDBIcon-1.0:
    url: https://repos.curseforge.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
    tag: latest

ignore:
  - "*.md"
  - .gitignore
  - .claude
  - .vscode
  - .git
  - .github
  - docs
  - feedback
  - Art/inner
