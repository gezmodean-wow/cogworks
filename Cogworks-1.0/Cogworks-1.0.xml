<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <!--
        Cogworks-1.0 load manifest. Consumer cogs reference this single file
        from their .toc; it pulls in the library entry point and the per-area
        modules (Items, Realms, ...) in dependency order.

        Consumer .toc snippet:
            Libs\Cogworks-1.0\Cogworks-1.0.xml
    -->

    <Script file="Cogworks-1.0.lua" />
    <Script file="Items.lua" />
    <Script file="Realms.lua" />
    <Script file="API.lua" />
    <Script file="Icons.lua" />
    <Script file="Sections.lua" />
    <Script file="Forms.lua" />
    <Script file="TabPanel.lua" />
    <Script file="MiniView.lua" />
    <Script file="Text.lua" />
    <Script file="Wizard.lua" />
    <Script file="Tree.lua" />
    <Script file="ReorderableList.lua" />
    <Script file="SegmentedControl.lua" />
    <Script file="Scaling.lua" />
    <Script file="Debug.lua" />
    <Script file="ThemedMainFrame.lua" />
    <Script file="Drawer.lua" />
    <Script file="Slash.lua" />
    <Script file="Toast.lua" />

    <!-- ItemBase: data file before loader. The data file assigns
         CogworksItemBaseData_<locale> to a global; ItemBase.lua picks it up
         lazily on first ResolveName/GetItem/Load call. -->
    <Script file="Data\ItemBase-Generated-enUS.lua" />
    <Script file="ItemBase.lua" />

</Ui>
